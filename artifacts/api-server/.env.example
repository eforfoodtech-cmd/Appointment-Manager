# Core authentication
SESSION_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_SECRET=replace-with-a-different-long-random-secret

# Password-reset delivery webhooks
# Each endpoint receives:
# { purpose, channel, to, code, expiresAt, resetId }
# and must return a 2xx response after handing the message to its provider.
PASSWORD_RESET_EMAIL_WEBHOOK_URL=https://example.com/hooks/password-reset-email
PASSWORD_RESET_SMS_WEBHOOK_URL=https://example.com/hooks/password-reset-sms
PASSWORD_RESET_WEBHOOK_TOKEN=replace-with-the-webhook-bearer-token

# Password-reset policy
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_MAX_REQUESTS=5
PASSWORD_RESET_IP_RATE_MAX_REQUESTS=50

# Development/test only. Never enable in production.
PASSWORD_RESET_EXPOSE_CODE=false
